# ShopSmart AI 2.0 Environment Configuration Template
# Copy to .env and set actual environment variables as needed.
# DO NOT commit real API keys or credentials.

# Server Port
PORT=8080

# External Product Provider Configuration (Disabled by default)
PRODUCT_PROVIDER_ENABLED=false
PRODUCT_PROVIDER_BASE_URL=https://api.example-retailer.com/v1
PRODUCT_PROVIDER_API_KEY=your_api_key_here
PRODUCT_PROVIDER_TIMEOUT=5000
PRODUCT_PROVIDER_PAGE_SIZE=20

# ─── Flipkart Affiliate API Configuration ─────────────────────────────────────
# Flipkart is India's largest e-commerce platform offering millions of real products.
# Register at https://affiliate.flipkart.com/registerme to obtain credentials.
# Generate API token at https://affiliate.flipkart.com/api/api-token

# Enable/Disable Flipkart provider
FLIPKART_PROVIDER_ENABLED=false

# Flipkart Affiliate Tracking ID (required)
# Example: youraffiliateID
FLIPKART_AFFILIATE_ID=

# Flipkart Affiliate API Token (required)
# Example: xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FLIPKART_AFFILIATE_TOKEN=

# Flipkart API Base URL (default: https://affiliate-api.flipkart.net/affiliate/api)
FLIPKART_API_BASE_URL=https://affiliate-api.flipkart.net/affiliate/api

# Request timeout in milliseconds (default: 5000)
FLIPKART_API_TIMEOUT=5000


# ─── Amazon Product Advertising API Configuration ────────────────────────────
# Placeholder — no provider implementation exists yet.
# Register at https://affiliate-program.amazon.in/ to obtain credentials.
# Enable only after creating AmazonProductProvider implementation.

# Enable/Disable Amazon provider (keep false until implemented)
AMAZON_PROVIDER_ENABLED=false

# AWS IAM Access Key for PA API v5 (required when enabled)
AMAZON_ACCESS_KEY=

# AWS IAM Secret Key — NEVER commit real values (required when enabled)
AMAZON_SECRET_KEY=

# Amazon Associates Partner / Tracking Tag (required when enabled)
AMAZON_PARTNER_TAG=

# Target marketplace (default: www.amazon.in for India)
AMAZON_MARKETPLACE=www.amazon.in

# Request timeout in milliseconds (default: 5000)
AMAZON_API_TIMEOUT=5000

# ─── Product Cache Configuration ─────────────────────────────────────────────
# TTL for external provider results (seconds, default: 300 = 5 minutes)
PRODUCT_CACHE_TTL_SECONDS=300

# Maximum entries in the in-memory cache before oldest are evicted
PRODUCT_CACHE_MAX_ENTRIES=200

# ─── Provider Rate-Limit Configuration ───────────────────────────────────────
# Maximum requests per provider per window (default: 100)
RATELIMIT_MAX_REQUESTS=100

# Window duration in seconds (default: 60)
RATELIMIT_WINDOW_SECONDS=60

# Cooldown seconds imposed after a rate-limit signal from a provider (default: 30)
RATELIMIT_COOLDOWN_SECONDS=30
